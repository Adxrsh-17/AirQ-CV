# Local datasets and generated results. Source/config files for the new generation
# pipeline (including provenance/ and data/generation/) remain eligible for Git.
/data/raw/
/data/raw_v2/
/data/interim/
/data/processed/
/data/cache/
/outputs/

# Experiment output trees stay ignored, while the Phase 0C design snapshot is
# explicitly reviewable. Generated rasters/arrays are also excluded globally
# by the extension rules below.
/experiments/*
!/experiments/E00C_design_20260915T164156Z/
!/experiments/E00C_design_20260915T164156Z/*.md
!/experiments/E00C_design_20260915T164156Z/*.yaml

# Large raster, array, archive, and model files anywhere in the tree.
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.npy
*.npz
*.nc
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.pkl
*.joblib
*.zip
*.7z
*.tar
*.gz

