# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class

# Caching and temporary files
.pytest_cache/
.coverage
htmlcov/
*.log
!training/logs/*.log

# Environments
.env
.venv
env/
venv/
ENV/

# Large Datasets & Binary Satellite Rasters / Tensors (>100MB / Multi-GB)
data/raw/
data/processed/s2_composites/
data/processed/s5p_composites/
cache/
**/cache/
*.zip
*.tar.gz
*.tif
*.tiff
*.pt
*.pth
*.npy
*.npz

# Runs: exclude large weights/caches but allow benchmark metrics/jsons
runs/**/*.pt
runs/**/*.pth
runs/**/*.npy
runs/**/checkpoints/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
kaggle_out/
kaggle_out2/
